#ifndef INC_CONTROL_AXES_H_
#define INC_CONTROL_AXES_H_

#include "control_motor.h"
#include "speed_profile.h"


#define AXES_NUM 3

#define MAX_SPEED 200 // mm / s millimeter per second

typedef enum{
	X_AXIS,
	Y_AXIS,
	Z_AXIS
}AxisType;

typedef enum{
	AXIS_IDLE,
	AXIS_HOMING,
	AXIS_CALIBRATING,
	AXIS_MOVING	,

}AxisMode;

typedef struct{
	AxisType axis;
	AxisMode mode;

	float limit;

	uint32_t totalSteps;
	uint32_t currentSteps;
	uint32_t stepsDone;
	Motor motor;

	SpeedProfile speed;
}Axis;

extern Axis axes[AXES_NUM];



void initAxes();

void Calibration();

void MoveToOrigin();

void StopAxis(AxisType axis);

uint8_t isHoming();

uint8_t isCalibrating();

void MoveTo();



/*
 * Let's solve math problems
 * We have to define all the variables we will use
 * PSC (PreScaler = 71) (change all you want)
 * F_TIM (Timer Frequency =  72 MHz)
 *
 * We have our stepper motors with 1 forth (1/4) step -> 1 round = 800 step
 * (if we use choose to use full step with our stepper motors -> 1 round = 200 step)
 *
 * I have to specify that the our linear actuators (Lead Screw) is T8/2
 * 1 round = 2 mm -> 800 step = 2mm
 * -> we have x = 1 / 400 (mm/step)
 * We have velocity v (unit: mm/s) and s (unit: step/s)
 * s = v / x = 400 * v
 *
 *
 * We have T = 1 / f  for example we have a PWM freq = 1kHz
 * -> T = 1ms -> as 1ms passed we have 1 step -> 1k step/s = 1kHz
 * -> f_PWM = 1kHz = 1000 step/s
 * so we have
 *
 * f_PWM = s = 400 * v
 *
 *
 * f_PWM = f_TIM / ((PSC+1) * (ARR+1)) = 72MHz / (72 * (ARR +1))
 * 400 * v = 1MHz / (ARR + 1)
 * v = 2500 / (ARR + 1) (mm / s)
 *
 * */

