#ifndef INC_TRAJECTORY_BLOCK_H_
#define INC_TRAJECTORY_BLOCK_H_


typedef enum {
	LINE,
	ARC
}PathType;

struct TrajectoryBlock{
	PathType path;

	float x0, y0, z0;
	float x1, y1 ,z1;

	float max_velocity;
	float acceleration;

	float entry_velocity;
	float exit_velocity;
};



#endif /* INC_TRAJECTORY_BLOCK_H_ */
