#include "queue.h"

uint8_t enqueue(TrajectoryBlock* block){
	if((back + 1) % QUEUE_SIZE == front){
		return Result.FAILED;
	}

	queue[back+1 % QUEUE_SIZE] = *block;
	back ++;
	return Result.SUCCESS;
}
uint8_t dequeue(){
	if(front == back){
		return Result.Failed;
	}

}
TrajectoryBlock* peek();


