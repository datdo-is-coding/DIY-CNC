void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim){
	if(htim -> Instance == TIM2){
		if(axes[X_AXIS].mode == AXIS_CALIBRATING){
			if((axes[X_AXIS].speed.currentSpeed + axes[X_AXIS].speed.acceleration)
					< MAX_SPEED){
				axes[X_AXIS].speed.currentSpeed += axes[X_AXIS].speed.acceleration;
			}
			else{
				axes[X_AXIS].speed.currentSpeed == MAX_SPEED;
			}
			axes[X_AXIS].limit += MM_PER_STEP;
			SetSpeedAxis(&axes[X_AXIS]);
		}
	}

	if(htim -> Instance == TIM3){
		if(axes[Y_AXIS].mode == AXIS_CALIBRATING){
			if((axes[Y_AXIS].speed.currentSpeed + axes[Y_AXIS].speed.acceleration)
					< MAX_SPEED){
				axes[Y_AXIS].speed.currentSpeed += axes[Y_AXIS].speed.acceleration;
			}
			else{
				axes[Y_AXIS].speed.currentSpeed == MAX_SPEED;
			}


			axes[Y_AXIS].limit += MM_PER_STEP;
		}
	}

	if(htim -> Instance == TIM4){
		if(axes[Z_AXIS].mode == AXIS_CALIBRATING){
			if((axes[Z_AXIS].speed.currentSpeed + axes[Z_AXIS].speed.acceleration)
					< MAX_SPEED){
				axes[Z_AXIS].speed.currentSpeed += axes[Z_AXIS].speed.acceleration;
			}
			else{
				axes[Z_AXIS].speed.currentSpeed == MAX_SPEED;
			}

			axes[Z_AXIS].limit += MM_PER_STEP;

		}
	}

}

