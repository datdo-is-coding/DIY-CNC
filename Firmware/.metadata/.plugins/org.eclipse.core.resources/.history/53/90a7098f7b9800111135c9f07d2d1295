#ifndef INC_CONTROL_AXES_H_
#define INC_CONTROL_AXES_H_

#include "control_motor.h"

#define AXES_NUM 3

typedef enum{
	X_AXIS,
	Y_AXIS,
	Z_AXIS
}AxisType;

typedef enum{
	Free,
	Origional,
	Calibrate,
	Moving,

}AxisMode;

typedef struct{
	AxisType axis;
	AxisMode mode;

	float limit;

	uint32_t totalSteps;
	uint32_t currentSteps;
	uint32_t stepsDone;
	Motor motor;
}Axis;

static extern Axis axes[AXES_NUM];

static Motor motors[3];

void initAxes(){
	InitMotor(&motors[X_AXIS], &htim2, TIM_CHANNEL_1, HIGH, GPIOB, GPIO_PIN_0);
	InitMotor(&motors[Y_AXIS], &htim3, TIM_CHANNEL_1, LOW , GPIOB, GPIO_PIN_1);
	InitMotor(&motors[Z_AXIS], &htim4, TIM_CHANNEL_1, HIGH, GPIOB, GPIO_PIN_2);

	for( uint8_t i = X_AXIS; i < AXES_NUM; i++){
		axes[i].axis = i;
		axes[i].mode = Free;
		axes[i].motor = motor[i];

		axis.limit = 0;
		axes[i].currentSteps = 0;
		axes[i].totalSteps   = 0;
		axes[i].stepsDone 	 = 0;
	}
}

void Calibration(){
	for ( uint8_t i = X_AXIS ; i < AXES_NUM; i++){
		axes[axis].mode = Calibrate;
		StartMotor(axes[axis].motor, 9999, Forward);
	}
}

void MoveToOrigin(){
	for ( uint8_t i = X_AXIS ; i < AXES_NUM; i++){
		axes[axis].mode = Origional;
		StartMotor(axes[axis].motor, 9999, Backward);
	}
}
#endif /* INC_CONTROL_AXES_H_ */
