#include "control_motor.h"

void InitMotor(TIM_HandleTypeDef tim, DMA_HandleTypeDef dma, uint32_t channel){
	// Initialize axis for each motor
	motors.tim  = tim;
	motors.dma_tim = dma;
	motors.channel = channel;

	motors.ARR = 0;
	motors.duty_value = 0;

}

void StartMotor(uint32_t arr_value, uint16_t steps){
	motors.ARR = arr_value;
	motors.duty_value = (value + 1) / 2;

	__HAL_TIM_SET_AUTORELOAD(&motors.tim, motors.ARR);

	HAL_TIM_PWM_Start_DMA(&motors.tim, motors.channel, &motors.duty_value, steps);

	__HAL_TIM_ENABLE_IT(&motors.tim, TIM_IT_UPDATE);
}

void StopMotor(Axis axis){

	HAL_TIM_PWM_Stop_DMA(&motors[axis].tim, motors[axis].channel );

	__HAL_TIM_DISABLE_IT(&motors[axis].tim, TIM_IT_UPDATE);

}
