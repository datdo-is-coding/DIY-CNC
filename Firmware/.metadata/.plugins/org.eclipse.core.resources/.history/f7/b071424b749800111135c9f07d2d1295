#ifndef INC_AXES_H_
#define INC_AXES_H_

#include "control_motor.h"

#define AXES_NUM 3

typedef enum{
	X_AXIS,
	Y_AXIS,
	Z_AXIS
}AxisType;

typedef struct{
	AxisType axis;

	uint32_t totalSteps;
	uint32_t currentSteps;
	uint32_t stepsDone;
}Axis;

static extern Axis axes[AXES_NUM];



#endif /* INC_AXES_H_ */
