}

void StopMotor(Axis axis){
	HAL_TIM_PWM_Stop_DMA(&htim3, TIM_CHANNEL_1);
	__HAL_TIM_DISABLE_IT(&htim3, TIM_IT_UPDATE);
	coord_mode_Y = False;
}
