#include "control_motor.h"

void InitMotor(TIM_HandleTypeDef tim, DMA_HandleTypeDef dma, uint32_t channel){
	// Initialize axis for each motor
	motors[i].tim  = tim[i];
	motors[i].dma_tim = dma[i];
	motors[i].channel = channel;

	motors[i].ARR = 0;
	motors[i].duty_value = 0;

}

void StartMotor(uint32_t arr_value, uint16_t steps){
	motors[i].ARR = arr_value;
	motors[i].duty_value = (value + 1) / 2;

	__HAL_TIM_SET_AUTORELOAD(&motors[i].tim, motors[i].ARR);

	HAL_TIM_PWM_Start_DMA(&motors[i].tim, motors[i].channel, &motors[i].duty_value, steps);

	__HAL_TIM_ENABLE_IT(&htim3 , TIM_IT_UPDATE);
}

void StopMotor(Axis axis){

	HAL_TIM_PWM_Stop_DMA(&motors[axis].tim, motors[axis].channel );

	__HAL_TIM_DISABLE_IT(&motors[axis].tim, TIM_IT_UPDATE);

}
