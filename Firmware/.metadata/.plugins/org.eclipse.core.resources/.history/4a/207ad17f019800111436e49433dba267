#include "queue.h"
#include "stddef.h"


uint8_t enqueue(TrajectoryBlock* block){
	if((back + 1) % QUEUE_SIZE == front){
		return Result.FAILED;
	}

	back = (back + 1) % QUEUE_SIZE;
	queue[back] = *block;

	return SUCCESS;
}
uint8_t dequeue(){
	if(front == back){
		return Failed;
	}

	front = (front + 1) % QUEUE_SIZE;

	return SUCCESS;


}
TrajectoryBlock* peek(){
	if( front == back ) return NULL;


	return &queue[front];

}

